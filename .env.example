# 海洋守护者环境变量模板
# 复制为项目根目录 .env 后按需修改；真实密钥不要提交 Git。

# Ollama（当前统一使用 DeepSeek R1 1.5B，不再使用 ocean-assistant）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_KEEP_ALIVE=10m
LLM_TIMEOUT_SECONDS=120

# RAG
RAG_ENABLED=true
RAG_TOP_K=3
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma_db

# 数字人（仅在使用 XmovAvatar 时配置；AppSecret 只放 .env）
DH_APP_ID=
DH_APP_SECRET=

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
