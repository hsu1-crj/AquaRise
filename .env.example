# ============================================================
# 海洋守护者 - 环境变量配置模板
# ============================================================
# 使用说明:
#   1. 将此文件复制为 .env:  cp .env.example .env
#   2. 在 .env 中填写实际值（.env 已由 .gitignore 排除，不会提交 Git）
#   3. .env.example 本身只含占位符，可安全提交
#
# 敏感字段（appSecret 等）仅在 .env 中填写，绝不写入代码或日志。
# ============================================================


# ──────────────────────────────────────────────────────────
# 数字人 API 平台（魔珐星云具身智能SDK）
# ──────────────────────────────────────────────────────────
# 在平台控制台获取；appSecret 为高敏感字段，不得泄露
DH_APP_ID=
DH_APP_SECRET=


# ──────────────────────────────────────────────────────────
# Ollama 本地推理服务
# ──────────────────────────────────────────────────────────
# 本地开发: http://localhost:11434
# 局域网共享: http://<服务器IP>:11434
OLLAMA_URL=http://localhost:11434

# 生产模型: ocean-assistant  （LoRA微调后打包）
# 演示模型: qwen2:0.5b       （无LoRA，快速体验）
OLLAMA_MODEL=ocean-assistant


# ──────────────────────────────────────────────────────────
# LLM 生成参数（可按需调整，无需改代码）
# ──────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048


# ──────────────────────────────────────────────────────────
# RAG 知识库
# ──────────────────────────────────────────────────────────
# 是否在对话 API 中默认启用 RAG（前端也可在请求体中覆盖）
RAG_ENABLED=true
# 每次检索返回的文档块数
RAG_TOP_K=4

# 嵌入模型 - 使用本地缓存即可，无需联网
# Windows 下若出现连接超时，启动时设置 HF_HUB_OFFLINE=1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 相对项目根目录的路径（大文件不进 Git，只需本地存在）
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma_db


# ──────────────────────────────────────────────────────────
# FastAPI 服务
# ──────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
