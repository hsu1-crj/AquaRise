# 海洋守护者环境变量模板
# 复制为项目根目录 .env 后按需修改；真实密钥不要提交 Git。

# Ollama（正式使用海洋领域微调模型；deepseek-r1:1.5b 作为回滚基线）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ds-ocean_mingzhe
# 温度默认 0.45（对话自然度）；若用于严格评测可调回 0.2
LLM_TEMPERATURE=0.45
LLM_MAX_TOKENS=768
LLM_KEEP_ALIVE=10m
LLM_TIMEOUT_SECONDS=120
# 默认 false：强制 [S1] 引用只对报告/法规/统计类问题生效（requires_citations 判定）；
# 设为 true 会回到"所有事实型回答逐段标引用"的旧行为
LLM_REQUIRE_CITATIONS=false

# RAG
RAG_ENABLED=true
RAG_TOP_K=3
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma_db

# 数字人（仅在使用 XmovAvatar 时配置；AppSecret 只放 .env）
DH_APP_ID=
DH_APP_SECRET=
DH_PROVIDER=xmov
DH_AVATAR_ID=ocean_guardian_01
DH_VOICE_ID=zh_female_ocean
DH_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session
DH_SDK_URL=https://media.xingyun3d.com/xingyun3d/general/litesdk/xmovAvatar@latest.js
# SDK 内容更新后必须重新计算并更新该 SHA-384，否则浏览器会拒绝加载未知版本。
DH_SDK_INTEGRITY=sha384-krYu4ZHwmSNtXwXO81hJ8Ec0SEHTHXqM4Ypzvs7rv8cahg7+oCMcMSYwyxuTaqDA

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
