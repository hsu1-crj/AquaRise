# ============================================================
# 海洋守护者 前端环境变量
# ============================================================
# 使用: cp .env.example .env 然后填入实际值
# 只有 VITE_ 前缀的变量暴露给浏览器代码
#
# 敏感字段（appSecret 等）仅填写于 .env，不提交 Git
# ============================================================

# API 模式: live=请求后端 / mock=演示数据
VITE_API_MODE=live

# ── 数字人 API 平台（魔珐星云具身智能SDK） ──
# 在平台控制台获取；appSecret 为高敏感字段
VITE_DH_APP_ID=
VITE_DH_APP_SECRET=
