# ============================================================
# 海洋守护者 前端环境变量
# ============================================================
# 使用: cp .env.example .env 然后填入实际值
# 只有 VITE_ 前缀的变量暴露给浏览器代码
#
# 敏感字段仅填写于项目根目录 .env，不提交 Git
# ============================================================

# API 模式: live=请求后端 / mock=演示数据
VITE_API_MODE=live

# 数字人 AppID / AppSecret 请填写项目根目录 .env 的 DH_APP_ID / DH_APP_SECRET。
# 不要在此文件或任何 VITE_* 变量中填写密钥。
